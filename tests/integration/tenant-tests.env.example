VENDIFY_TEST_SUPABASE_URL=https://your-staging-project.supabase.co
VENDIFY_TEST_SUPABASE_ANON_KEY=your-staging-anon-key
VENDIFY_TEST_TENANT_A_EMAIL=tenant-a@example.test
VENDIFY_TEST_TENANT_A_PASSWORD=replace-me
VENDIFY_TEST_TENANT_B_EMAIL=tenant-b@example.test
VENDIFY_TEST_TENANT_B_PASSWORD=replace-me

# Estas variables ejecutan DOS ventas reales y permanentes en staging.
# Usá solamente productos/cajas/usuarios creados para QA y con stock suficiente.
VENDIFY_TEST_SALES_SUPABASE_URL=https://your-staging-project.supabase.co
VENDIFY_TEST_SALES_ANON_KEY=your-staging-anon-key
VENDIFY_TEST_SALES_USER_A_EMAIL=sales-a@example.test
VENDIFY_TEST_SALES_USER_A_PASSWORD=replace-me
VENDIFY_TEST_SALES_USER_B_EMAIL=sales-b@example.test
VENDIFY_TEST_SALES_USER_B_PASSWORD=replace-me
VENDIFY_TEST_SALES_BRANCH_ID=replace-with-shared-staging-branch-uuid
VENDIFY_TEST_SALES_CASH_A_ID=replace-with-open-cash-a-uuid
VENDIFY_TEST_SALES_CASH_B_ID=replace-with-open-cash-b-uuid
VENDIFY_TEST_SALES_PRODUCT_A_ID=replace-with-test-product-a-uuid
VENDIFY_TEST_SALES_PRODUCT_B_ID=replace-with-test-product-b-uuid
# Total exacto de cada carrito: precio de A + precio de B.
VENDIFY_TEST_SALES_PAYMENT_AMOUNT=2
VENDIFY_TEST_CONFIRM_STAGING_SALES=RUN_SALES_CONCURRENCY
