{
  "name": "vendify",
  "version": "2.31.1",
  "private": true,
  "description": "Vendify POS/SaaS — engineering foundation for gradual TypeScript migration",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:vite": "vite build",
    "test": "npm run build:ts && node --test tests/unit/*.test.mjs",
    "qa:static": "node scripts/qa-baseline.mjs",
    "qa:rpc": "node scripts/check-rpc-contract.mjs",
    "qa": "npm run qa:static && npm run qa:rpc && npm run qa:secrets && npm run typecheck && npm test",
    "build": "node scripts/build-release.mjs",
    "verify:release": "node scripts/verify-release.mjs dist",
    "ci": "npm run qa && npm run lint && npm run build && npm run verify:release",
    "lint": "eslint src vite.config.ts",
    "qa:secrets": "node scripts/scan-secrets.mjs",
    "qa:rpc-source": "node scripts/rpc-source-coverage.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.1.0"
  }
}
