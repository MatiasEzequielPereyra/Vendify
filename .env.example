# Reserved for future build-time development/staging configuration.
# Never commit service_role or private provider tokens.
VENDIFY_ENV=development

# Real staging backend (public browser configuration only).
# Leave both unset for static CI/artifact validation; browser preview refuses that mode.
# VENDIFY_STAGING_SUPABASE_URL=https://<staging-project-ref>.supabase.co
# VENDIFY_STAGING_SUPABASE_ANON_KEY=<public-anon-jwt>
